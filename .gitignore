# Ignore Python-related files
.env
/config.py
setup.py
build/
*egg-info/
**/__pycache__/

# Ignore virtual environment directories
.venv/

# Ignore editor/IDE configuration files
.idea/
.vscode/

# Keep the worktree marker, but ignore generated worktree contents
.agents/worktrees/*
!.agents/worktrees/.gitkeep

# Ignore all files in content/ except README.md
content/*
!content/README.md

# Ignore Node & Astro dependencies and build output (at any directory depth)
node_modules/
.astro/
dist/
reader/public/pagefind/
.github/
